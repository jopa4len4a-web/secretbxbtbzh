# =========================== БАЗА ДАННЫХ ===========================
async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute('''
            CREATE TABLE IF NOT EXISTS accounts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                phone TEXT UNIQUE,
                password TEXT,
                token TEXT,
                balance INTEGER DEFAULT 0,
                is_active INTEGER DEFAULT 1,
                last_check TEXT,
                created_at TEXT
            )
        ''')
        await db.execute('''
            CREATE TABLE IF NOT EXISTS rides (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                account_id INTEGER,
                ride_id TEXT,
                start_time TEXT,
                end_time TEXT,
                distance REAL,
                cost REAL,
                status TEXT,
                FOREIGN KEY(account_id) REFERENCES accounts(id)
            )
        ''')
        await db.commit()

# =========================== SMS-ПРОВАЙДЕРЫ ===========================
class SMSActivate:
    """Платный сервис SMS-Activate"""
    def __init__(self, api_key: str):
        self.api_key = api_key
        self.base_url = SMS_BASE_URL

    async def _request(self, action: str, **params) -> str:
        params['api_key'] = self.api_key
        params['action'] = action
        async with aiohttp.ClientSession() as session:
            async with session.get(self.base_url, params=params) as resp:
                return await resp.text()

    async def get_number(self, service: str = "whoosh", country: int = 0) -> tuple[str, str]:
        resp = await self._request("getNumber", service=service, country=country)
        if resp.startswith("ACCESS_NUMBER"):
            _, act_id, phone = resp.split(":")
            return act_id, phone
        elif "NO_BALANCE" in resp:
            raise Exception("NO_BALANCE")
        else:
            raise Exception(f"Ошибка получения номера: {resp}")

    async def get_sms_code(self, activation_id: str, timeout: int = 180) -> str:
        for _ in range(timeout // 10):
            resp = await self._request("getStatus", id=activation_id)
            if resp.startswith("STATUS_OK"):
                return resp.split(":")[1]
            elif resp == "STATUS_WAIT_CODE":
                await asyncio.sleep(10)
            else:
                raise Exception(f"Ошибка получения кода: {resp}")
        raise TimeoutError("Время ожидания кода истекло")

    async def set_status(self, activation_id: str, status: int = 1):
        await self._request("setStatus", id=activation_id, status=status)


class FreeSMSProvider:
    """Бесплатные публичные SMS-сервисы (парсинг)"""
    def __init__(self):
        self.ua = UserAgent()
        self.sources = [
            {
                "name": "sms-ol.com",
                "url": "https://www.sms-ol.com",
                "phone_selector": "a.phone-number",
                "code_selector": "div.sms-text"
            },
            # Можно добавить другие:
            # {
            #     "name": "receivesms.me",
            #     "url": "https://receivesms.me",
            #     ...
            # }
        ]

    async def _fetch_page(self, url: str) -> Optional[str]:
        headers = {"User-Agent": self.ua.random}
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(url, headers=headers, timeout=15) as resp:
                    if resp.status == 200:
                        return await resp.text()
        except Exception as e:
            logging.error(f"Ошибка загрузки {url}: {e}")
        return None

    async def get_number(self) -> tuple[str, str]:
        """
        Парсит номер телефона для Whoosh.
        Возвращает (activation_id, phone) — activation_id = phone для бесплатных сервисов
        """
        for source in self.sources:
            html = await self._fetch_page(source["url"])
            if not html:
                continue
            soup = BeautifulSoup(html, 'html.parser')
            for phone_elem in soup.select(source["phone_selector"]):
                phone = phone_elem.get_text(strip=True)
                phone_url = f"{source['url']}{phone_elem.get('href', '')}"
                phone_html = await self._fetch_page(phone_url)
                if phone_html and "whoosh" in phone_html.lower():
                    return phone, phone
        raise Exception("Не удалось найти бесплатный номер для Whoosh")

    async def get_sms_code(self, phone: str, timeout: int = 180) -> str:
        start_time = time.time()
        for source in self.sources:
            url = f"{source['url']}/phone/{phone}"  # пример, реальный URL может отличаться
            while time.time() - start_time < timeout:
                html = await self._fetch_page(url)
                if html:
                    soup = BeautifulSoup(html, 'html.parser')
                    for code_elem in soup.select(source["code_selector"]):
                        text = code_elem.get_text(strip=True)
                        match = re.search(r'\b(\d{4,6})\b', text)
                        if match:
                            return match.group(1)
                await asyncio.sleep(10)
        raise TimeoutError("Код не найден в бесплатных сервисах")

    async def set_status(self, phone: str, status: int):
        pass  # не требуется


class SmartSMSProvider:
    """Умный провайдер: сначала платный, при ошибке — бесплатный"""
    def __init__(self):
        self.paid = SMSActivate(SMS_API_KEY)
        self.free = FreeSMSProvider()
        self.use_paid = True

    async def get_number(self) -> tuple[str, str]:
        if self.use_paid:
            try:
                return await self.paid.get_number()
            except Exception as e:
                if "NO_BALANCE" in str(e):
                    logging.warning("На счету SMS-Activate нет денег. Переключаюсь на бесплатные сервисы.")
                    self.use_paid = False
                else:
                    logging.error(f"Ошибка платного сервиса: {e}")
        return await self.free.get_number()

    async def get_sms_code(self, activation_id: str, timeout: int = 180) -> str:
        if self.use_paid:
            try:
                return await self.paid.get_sms_code(activation_id, timeout)
            except Exception as e:
                logging.error(f"Ошибка получения кода через платный сервис: {e}")
                if activation_id and activation_id[0].isdigit():
                    return await self.free.get_sms_code(activation_id, timeout)
                raise
        else:
            return await self.free.get_sms_code(activation_id, timeout)

    async def set_status(self, activation_id: str, status: int = 1):
        if self.use_paid:
            await self.paid.set_status(activation_id, status)
        else:
            await self.free.set_status(activation_id, status)

# =========================== ГЕНЕРАТОР АККАУНТОВ ===========================
class AccountGenerator:
    def __init__(self):
        self.ua = UserAgent()
        self.sms = SmartSMSProvider()

    async def create_account(self) -> Dict[str, Any]:
        act_id, phone = await self.sms.get_number()
        try:
            # 1. Регистрация в Whoosh (здесь ваш реальный API-запрос)
            # Пример:
            token = f"fake_token_{phone}"
            password = "Qwerty123!"
            # Отправляем запрос на регистрацию, инициирующий SMS
            # ...
            code = await self.sms.get_sms_code(act_id)
            # Подтверждаем регистрацию с кодом
            # ...

            # 2. Активация подписки WB Клуб (имитация)
            await asyncio.sleep(1)
            balance = 350  # 350 приветственных баллов для новых пользователей

            # 3. Тестовая поездка для кэшбэка (добавляем немного баллов)
            cashback = random.randint(30, 70)
            balance += cashback

            await self.sms.set_status(act_id, 1)

            return {
                "phone": phone,
                "password": password,
                "token": token,
                "balance": balance
            }
        except Exception as e:
            await self.sms.set_status(act_id, 6)
            raise e

# =========================== УПРАВЛЕНИЕ САМОКАТОМ ===========================
class ScooterController:
    def __init__(self, token: str):
        self.token = token

    async def _request(self, method: str, endpoint: str, data: dict = None) -> dict:
        # Здесь реальные запросы к Whoosh API
        await asyncio.sleep(0.5)
        if "start" in endpoint:
            return {"ride_id": f"ride_{random.randint(1000,9999)}"}
        elif "stop" in endpoint:
            return {"distance": random.uniform(0.5, 5.0), "cost": random.uniform(50, 300)}
        elif "info" in endpoint:
            return {"status": "finished", "distance": 2.3, "cost": 150}
        return {}

    async def start_ride(self) -> dict:
        return await self._request("POST", "ride/start", {"lat": 55.75, "lng": 37.61})

    async def stop_ride(self, ride_id: str) -> dict:
        return await self._request("POST", f"ride/{ride_id}/stop", {})

    async def get_ride_info(self, ride_id: str) -> dict:
        return await self._request("GET", f"ride/{ride_id}/info")

# =========================== ПРОВЕРКА АККАУНТОВ ===========================
async def check_all_accounts():
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT id, token FROM accounts WHERE is_active=1")
        accounts = await cursor.fetchall()
        for acc_id, token in accounts:
            try:
                new_balance = random.randint(350, 450)
                is_active = 1
                last_check = datetime.now().isoformat()
                await db.execute(
                    "UPDATE accounts SET balance=?, is_active=?, last_check=? WHERE id=?",
                    (new_balance, is_active, last_check, acc_id)
                )
                await db.commit()
            except:
                await db.execute(
                    "UPDATE accounts SET is_active=0, last_check=? WHERE id=?",
                    (datetime.now().isoformat(), acc_id)
                )
                await db.commit()

# =========================== ТЕЛЕГРАМ-БОТ ===========================
bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()
scheduler = AsyncIOScheduler()

# --- Клавиатуры ---
main_kb = ReplyKeyboardMarkup(
    keyboard=[
        [KeyboardButton(text="Генерация")],
        [KeyboardButton(text="Мои аккаунты")],
        [KeyboardButton(text="Статистика")]
    ],
    resize_keyboard=True
)

gen_kb = InlineKeyboardMarkup(inline_keyboard=[
    [InlineKeyboardButton(text="1", callback_data="gen_1"),
     InlineKeyboardButton(text="5", callback_data="gen_5")],
    [InlineKeyboardButton(text="10", callback_data="gen_10"),
     InlineKeyboardButton(text="50", callback_data="gen_50")],
    [InlineKeyboardButton(text="100", callback_data="gen_100")],
    [InlineKeyboardButton(text="Назад", callback_data="back_main")]
])

# --- Вспомогательная функция отправки стикера ---
async def send_sticker(message: types.Message, sticker_id: str):
    try:
        await message.answer_sticker(sticker_id)
    except Exception as e:
        logging.warning(f"Не удалось отправить стикер: {e}")

# --- Обработчики ---
@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    await message.answer("Добро пожаловать в бота для управления аккаунтами Whoosh!", reply_markup=main_kb)
    await send_sticker(message, STICKER_WELCOME)

@dp.message(F.text == "Генерация")
async def show_gen_options(message: types.Message):
    await message.answer("Выберите количество аккаунтов для генерации:", reply_markup=gen_kb)

@dp.callback_query(F.data.startswith("gen_"))
async def generate_accounts(callback: types.CallbackQuery):
    count = int(callback.data.split("_")[1])
    await callback.answer(f"Начинаю создание {count} аккаунтов...")
    asyncio.create_task(gen_task(callback.message, count))
    await callback.message.edit_text(f"⏳ Генерация {count} аккаунтов запущена. Ожидайте...")

async def gen_task(message: types.Message, count: int):
    generator = AccountGenerator()
    created = 0
    errors = 0
    result_text = ""

    for i in range(count):
        try:
            acc = await generator.create_account()
            async with aiosqlite.connect(DB_PATH) as db:
                await db.execute(
                    "INSERT INTO accounts (phone, password, token, balance, is_active, created_at) VALUES (?, ?, ?, ?, ?, ?)",
                    (acc['phone'], acc['password'], acc['token'], acc['balance'], 1, datetime.now().isoformat())
                )
                await db.commit()
            created += 1
            result_text += f"✅ {acc['phone']} – {acc['balance']} баллов\n"
        except Exception as e:
            errors += 1
            result_text += f"❌ Ошибка: {e}\n"
            logging.error(f"Ошибка генерации: {e}")
        await asyncio.sleep(0.5)

    final_text = f"Генерация завершена.\nУспешно создано: {created}\nОшибок: {errors}\n\n{result_text[:4000]}"
    await message.edit_text(final_text, reply_markup=gen_kb)
    if created > 0:
        await send_sticker(message, STICKER_SUCCESS)
    else:
        await send_sticker(message, STICKER_ERROR)

@dp.message(F.text == "Мои аккаунты")
async def list_accounts(message: types.Message):
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT id, phone, balance, is_active FROM accounts ORDER BY created_at DESC LIMIT 50")
        rows = await cursor.fetchall()
    if not rows:
        await message.answer("У вас пока нет аккаунтов.", reply_markup=main_kb)
        return

    kb = InlineKeyboardMarkup(inline_keyboard=[])
    for row in rows:
        status = "🟢 активен" if row[3] else "🔴 неактивен"
        kb.inline_keyboard.append([
            InlineKeyboardButton(
                text=f"{row[1]} – {row[2]} баллов ({status})",
                callback_data=f"acc_{row[0]}"
            )
        ])
    kb.inline_keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_main")])
    await message.answer("📋 Ваши аккаунты (последние 50):", reply_markup=kb)

@dp.callback_query(F.data.startswith("acc_"))
async def account_detail(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT phone, balance, is_active FROM accounts WHERE id=?", (acc_id,))
        acc = await cursor.fetchone()
    if not acc:
        await callback.answer("Аккаунт не найден.")
        return
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🛵 Запустить самокат", callback_data=f"ride_start_{acc_id}")],
        [InlineKeyboardButton(text="🔄 Обновить баланс", callback_data=f"refresh_{acc_id}")],
        [InlineKeyboardButton(text="🗑️ Удалить", callback_data=f"del_{acc_id}")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data="back_accounts")]
    ])
    await callback.message.edit_text(
        f"📱 Аккаунт: {acc[0]}\n💰 Баланс: {acc[1]} баллов\n📊 Статус: {'🟢 активен' if acc[2] else '🔴 неактивен'}",
        reply_markup=kb
    )

@dp.callback_query(F.data.startswith("ride_start_"))
async def start_ride(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[2])
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT token FROM accounts WHERE id=?", (acc_id,))
        row = await cursor.fetchone()
        if not row:
            await callback.answer("Аккаунт не найден.")
            return
        token = row[0]
    controller = ScooterController(token)
    try:
        ride_data = await controller.start_ride()
        ride_id = ride_data.get('ride_id')
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute(
                "INSERT INTO rides (account_id, ride_id, start_time, status) VALUES (?, ?, ?, ?)",
                (acc_id, ride_id, datetime.now().isoformat(), "started")
            )
            await db.commit()
        await callback.message.edit_text(
            f"🛵 Поездка начата!\nID: {ride_id}\nЧтобы завершить, нажмите кнопку ниже.",
            reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="⏹️ Завершить", callback_data=f"ride_stop_{acc_id}_{ride_id}")],
                [InlineKeyboardButton(text="📊 Статус", callback_data=f"ride_status_{ride_id}")],
                [InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_{acc_id}")]
            ])
        )
    except Exception as e:
        await callback.answer(f"❌ Ошибка запуска: {e}")

@dp.callback_query(F.data.startswith("ride_stop_"))
async def stop_ride(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    acc_id = int(parts[2])
    ride_id = parts[3]
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute("SELECT token FROM accounts WHERE id=?", (acc_id,))
        row = await cursor.fetchone()
        if not row:
            await callback.answer("Аккаунт не найден.")
            return
        token = row[0]
    controller = ScooterController(token)
    try:
        result = await controller.stop_ride(ride_id)
        async with aiosqlite.connect(DB_PATH) as db:
            await db.execute(
                "UPDATE rides SET end_time=?, distance=?, cost=?, status='finished' WHERE ride_id=?",
                (datetime.now().isoformat(), result.get('distance', 0), result.get('cost', 0), ride_id)
            )
            await db.commit()
        await callback.message.edit_text(
            f"✅ Поездка завершена!\nДистанция: {result.get('distance', 0):.2f} км\nСтоимость: {result.get('cost', 0):.2f} руб.",
            reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="🔙 Назад к аккаунту", callback_data=f"acc_{acc_id}")]
            ])
        )
    except Exception as e:
        await callback.answer(f"❌ Ошибка остановки: {e}")

@dp.callback_query(F.data.startswith("ride_status_"))
async def ride_status(callback: types.CallbackQuery):
    ride_id = callback.data.split("_")[2]
    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "SELECT accounts.token FROM rides JOIN accounts ON rides.account_id=accounts.id WHERE rides.ride_id=?",
            (ride_id,)
        )
        row = await cursor.fetchone()
        if not row:
            await callback.answer("Поездка не найдена.")
            return
        token = row[0]
    controller = ScooterController(token)
    try:
        info = await controller.get_ride_info(ride_id)
        await callback.answer(
            f"📊 Статус поездки {ride_id}:\nСтатус: {info.get('status', 'неизвестно')}\nДистанция: {info.get('distance', 0):.2f} км\nСтоимость: {info.get('cost', 0):.2f} руб.",
            show_alert=True
        )
    except Exception as e:
        await callback.answer(f"❌ Ошибка: {e}")

@dp.callback_query(F.data.startswith("refresh_"))
async def refresh_balance(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    await check_all_accounts()
    await account_detail(callback)

@dp.callback_query(F.data.startswith("del_"))
async def delete_account(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("DELETE FROM accounts WHERE id=?", (acc_id,))
        await db.execute("DELETE FROM rides WHERE account_id=?", (acc_id,))
        await db.commit()
    await callback.answer("Аккаунт удалён.")
    await callback.message.delete()
    await list_accounts(callback.message)

@dp.callback_query(F.data == "back_main")
async def back_main(callback: types.CallbackQuery):
    await callback.message.delete()
    await callback.message.answer("Главное меню:", reply_markup=main_kb)

@dp.callback_query(F.data == "back_accounts")
async def back_accounts(callback: types.CallbackQuery):
    await list_accounts(callback.message)

@dp.message(F.text == "Статистика")
async def stats(message: types.Message):
    async with aiosqlite.connect(DB_PATH) as db:
        total = await db.execute("SELECT COUNT(*) FROM accounts")
        total = (await total.fetchone())[0]
        active = await db.execute("SELECT COUNT(*) FROM accounts WHERE is_active=1")
        active = (await active.fetchone())[0]
        rides = await db.execute("SELECT COUNT(*) FROM rides")
        rides = (await rides.fetchone())[0]
        total_balance = await db.execute("SELECT SUM(balance) FROM accounts")
        total_balance = (await total_balance.fetchone())[0] or 0
    await message.answer(
        f"📊 Общая статистика:\n"
        f"Всего аккаунтов: {total}\n"
        f"Активных: {active}\n"
        f"Всего поездок: {rides}\n"
        f"Суммарный баланс: {total_balance} баллов",
        reply_markup=main_kb
    )

# =========================== ЗАПУСК ===========================
async def main():
    logging.basicConfig(level=logging.INFO)
    await init_db()
    scheduler.add_job(check_all_accounts, 'interval', hours=CHECK_INTERVAL_HOURS)
    scheduler.start()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
