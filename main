    sys.exit(1)

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()
scheduler = AsyncIOScheduler()

# --- Клавиатуры ---
main_kb = ReplyKeyboardMarkup(
    keyboard=[
        [KeyboardButton(text="🛴 Генерация")],
        [KeyboardButton(text="➕ Ввести номер")],
        [KeyboardButton(text="👥 Аккаунты")],
        [KeyboardButton(text="📊 Статистика")]
    ],
    resize_keyboard=True
)

gen_kb = InlineKeyboardMarkup(inline_keyboard=[
    [InlineKeyboardButton(text="1", callback_data="gen_1"), InlineKeyboardButton(text="5", callback_data="gen_5")],
    [InlineKeyboardButton(text="10", callback_data="gen_10"), InlineKeyboardButton(text="50", callback_data="gen_50")],
    [InlineKeyboardButton(text="100", callback_data="gen_100")],
    [InlineKeyboardButton(text="🔙 Назад", callback_data="back_main")]
])

async def send_sticker(chat_id, sticker_id):
    if sticker_id and sticker_id.startswith("CAAC"):
        try:
            await bot.send_sticker(chat_id, sticker_id)
        except Exception as e:
            logging.warning(f"Стикер не отправлен: {e}")

# --- FSM для ручного ввода ---
class AddPhoneStates(StatesGroup):
    waiting_phone = State()
    waiting_code = State()

# --- Обработчики ---
@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    await message.answer(
        f"{SCOOTER_HTML} Добро пожаловать!\nВыберите действие:",
        reply_markup=main_kb, parse_mode='HTML'
    )
    await send_sticker(message.chat.id, STICKER_WELCOME)

@dp.message(F.text == "🛴 Генерация")
async def show_gen_options(message: types.Message):
    await message.answer(
        f"{SCOOTER_HTML} Выберите количество аккаунтов:",
        reply_markup=gen_kb, parse_mode='HTML'
    )

@dp.callback_query(F.data.startswith("gen_"))
async def generate(callback: types.CallbackQuery):
    count = int(callback.data.split("_")[1])
    await callback.answer(f"Начинаю создание {count} аккаунтов...")
    asyncio.create_task(gen_task(callback.message, count))
    await callback.message.edit_text(
        f"{SCOOTER_HTML} ⏳ Генерация {count} аккаунтов запущена...",
        parse_mode='HTML'
    )

async def gen_task(message: types.Message, count: int):
    generator = AccountGenerator()
    created = 0
    errors = 0
    result_text = ""
    for i in range(count):
        try:
            acc = await generator.create_account_auto()
            execute_db(
                "INSERT INTO accounts (phone, password, token, refresh_token, balance, is_active, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
                (acc['phone'], acc['password'], acc['token'], acc.get('refresh_token', ''), acc['balance'], 1, datetime.now().isoformat())
            )
            created += 1
            result_text += f"{CHECK_HTML} {acc['phone']} – {acc['balance']} баллов\n"
        except Exception as e:
            errors += 1
            result_text += f"❌ Ошибка: {e}\n"
        await asyncio.sleep(0.5)
    final_text = f"Генерация завершена.\nУспешно: {created}\nОшибок: {errors}\n\n{result_text[:4000]}"
    await message.edit_text(final_text, reply_markup=gen_kb)
    if created > 0:
        await send_sticker(message.chat.id, STICKER_SUCCESS)
    else:
        await send_sticker(message.chat.id, STICKER_ERROR)

@dp.message(F.text == "➕ Ввести номер")
async def start_add_phone(message: types.Message, state: FSMContext):
    await message.answer(
        f"{PHONE_HTML} Введите номер в формате +7XXXXXXXXXX",
        parse_mode='HTML'
    )
    await state.set_state(AddPhoneStates.waiting_phone)

@dp.message(AddPhoneStates.waiting_phone)
async def process_phone(message: types.Message, state: FSMContext):
    phone_raw = re.sub(r'\D', '', message.text)
    if len(phone_raw) not in (10, 11):
        await message.answer("❌ Неверный формат. Попробуйте снова.")
        return
    if len(phone_raw) == 11 and phone_raw.startswith('7'):
        phone = '+' + phone_raw
    elif len(phone_raw) == 11 and phone_raw.startswith('8'):
        phone = '+' + '7' + phone_raw[1:]
    elif len(phone_raw) == 10:
        phone = '+7' + phone_raw
    else:
        await message.answer("❌ Неверный формат.")
        return

    await state.update_data(phone=phone)

    try:
        generator = AccountGenerator()
        await generator.api.register(phone)
        await message.answer(
            f"{CHECK_HTML} Код отправлен на ваш номер.\nВведите его (4-6 цифр):",
            parse_mode='HTML'
        )
        await state.set_state(AddPhoneStates.waiting_code)
    except Exception as e:
        await message.answer(f"❌ Ошибка при отправке SMS: {e}")
        await state.clear()

@dp.message(AddPhoneStates.waiting_code)
async def process_code(message: types.Message, state: FSMContext):
    code = re.sub(r'\D', '', message.text)
    if len(code) < 4 or len(code) > 6:
        await message.answer("❌ Код должен быть 4-6 цифр.")
        return

    data = await state.get_data()
    phone = data.get('phone')
    if not phone:
        await message.answer("❌ Ошибка. Начните заново.")
        await state.clear()
        return

    generator = AccountGenerator()
    try:
        acc = await generator.register_with_manual_code(phone, code)
        execute_db(
            "INSERT INTO accounts (phone, password, token, refresh_token, balance, is_active, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)",
            (acc['phone'], acc['password'], acc['token'], acc.get('refresh_token', ''), acc['balance'], 1, datetime.now().isoformat())
        )
        await message.answer(
            f"{CHECK_HTML} Аккаунт создан!\n{PHONE_HTML} {acc['phone']}\n💰 Баланс: {acc['balance']} баллов",
            parse_mode='HTML'
        )
        await send_sticker(message.chat.id, STICKER_SUCCESS)
    except Exception as e:
        await message.answer(f"❌ {str(e)}")
        await send_sticker(message.chat.id, STICKER_ERROR)
    await state.clear()

# --- Аккаунты ---
@dp.message(F.text == "👥 Аккаунты")
async def list_accounts(message: types.Message):
    rows = execute_db("SELECT id, phone, balance, is_active FROM accounts ORDER BY created_at DESC LIMIT 50")
    if not rows:
        await message.answer(
            f"{ACCOUNTS_HTML} Нет аккаунтов.",
            reply_markup=main_kb, parse_mode='HTML'
        )
        return
    kb = InlineKeyboardMarkup(inline_keyboard=[])
    for row in rows:
        status = "🟢 активен" if row[3] else "🔴 неактивен"
        kb.inline_keyboard.append([
            InlineKeyboardButton(text=f"{row[1]} – {row[2]} баллов ({status})", callback_data=f"acc_{row[0]}")
        ])
    kb.inline_keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_main")])
    await message.answer(
        f"{ACCOUNTS_HTML} Ваши аккаунты:",
        reply_markup=kb, parse_mode='HTML'
    )

@dp.callback_query(F.data.startswith("acc_"))
async def account_detail(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    row = execute_db("SELECT phone, balance, is_active, token FROM accounts WHERE id=?", (acc_id,))
    if not row:
        await callback.answer("Не найден.")
        return
    acc = row[0]
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🛵 Запустить самокат", callback_data=f"ride_start_{acc_id}")],
        [InlineKeyboardButton(text="🔄 Обновить баланс", callback_data=f"refresh_{acc_id}")],
        [InlineKeyboardButton(text="🗑️ Удалить", callback_data=f"del_{acc_id}")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data="back_accounts")]
    ])
    text = f"{PHONE_HTML} Аккаунт: {acc[0]}\n💰 Баланс: {acc[1]}\n📊 Статус: {'активен' if acc[2] else 'неактивен'}"
    await callback.message.edit_text(text, reply_markup=kb, parse_mode='HTML')

@dp.callback_query(F.data.startswith("ride_start_"))
async def start_ride(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[2])
    row = execute_db("SELECT token FROM accounts WHERE id=?", (acc_id,))
    if not row:
        await callback.answer("Аккаунт не найден.")
        return
    token = row[0][0]
    controller = ScooterController(token)
    try:
        ride_data = await controller.start_ride()
        ride_id = ride_data.get('ride_id')
        execute_db(
            "INSERT INTO rides (account_id, ride_id, start_time, status) VALUES (?, ?, ?, ?)",
            (acc_id, ride_id, datetime.now().isoformat(), "started")
        )
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="⏹️ Завершить", callback_data=f"ride_stop_{acc_id}_{ride_id}")],
            [InlineKeyboardButton(text="📊 Статус", callback_data=f"ride_status_{ride_id}")],
            [InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_{acc_id}")]
        ])
        await callback.message.edit_text(
            f"{SCOOTER_HTML} Поездка начата! ID: {ride_id}",
            reply_markup=kb, parse_mode='HTML'
        )
    except Exception as e:
        await callback.answer(f"Ошибка: {e}")

@dp.callback_query(F.data.startswith("ride_stop_"))
async def stop_ride(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    acc_id = int(parts[2])
    ride_id = parts[3]
    row = execute_db("SELECT token FROM accounts WHERE id=?", (acc_id,))
    if not row:
        await callback.answer("Аккаунт не найден.")
        return
    token = row[0][0]
    controller = ScooterController(token)
    try:
        result = await controller.stop_ride(ride_id)
        execute_db(
            "UPDATE rides SET end_time=?, distance=?, cost=?, status='finished' WHERE ride_id=?",
            (datetime.now().isoformat(), result.get('distance', 0), result.get('cost', 0), ride_id)
        )
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_{acc_id}")]
        ])
        await callback.message.edit_text(
            f"{CHECK_HTML} Поездка завершена!\nДистанция: {result.get('distance', 0):.2f} км\nСтоимость: {result.get('cost', 0):.2f} руб.",
            reply_markup=kb, parse_mode='HTML'
        )
    except Exception as e:
        await callback.answer(f"Ошибка: {e}")

@dp.callback_query(F.data.startswith("ride_status_"))
async def ride_status(callback: types.CallbackQuery):
    ride_id = callback.data.split("_")[2]
    row = execute_db(
        "SELECT accounts.token FROM rides JOIN accounts ON rides.account_id=accounts.id WHERE rides.ride_id=?",
        (ride_id,)
    )
    if not row:
        await callback.answer("Поездка не найдена.")
        return
    token = row[0][0]
    controller = ScooterController(token)
    try:
        info = await controller.get_info(ride_id)
        await callback.answer(
            f"{TIME_HTML} Статус: {info.get('status', 'неизвестно')}\nДистанция: {info.get('distance', 0):.2f} км\nСтоимость: {info.get('cost', 0):.2f} руб.",
            show_alert=True, parse_mode='HTML'
        )
    except Exception as e:
        await callback.answer(f"Ошибка: {e}", show_alert=True)

@dp.callback_query(F.data.startswith("refresh_"))
async def refresh_balance(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    await check_all_accounts()
    await account_detail(callback)

@dp.callback_query(F.data.startswith("del_"))
async def delete_account(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    execute_db("DELETE FROM accounts WHERE id=?", (acc_id,))
    execute_db("DELETE FROM rides WHERE account_id=?", (acc_id,))
    await callback.answer("Удалён.")
    await callback.message.delete()
    await list_accounts(callback.message)

@dp.callback_query(F.data == "back_main")
async def back_main(callback: types.CallbackQuery):
    await callback.message.delete()
    await callback.message.answer(
        f"{SCOOTER_HTML} Главное меню:",
        reply_markup=main_kb, parse_mode='HTML'
    )

@dp.callback_query(F.data == "back_accounts")
async def back_accounts(callback: types.CallbackQuery):
    await list_accounts(callback.message)

@dp.message(F.text == "📊 Статистика")
async def stats(message: types.Message):
    total = execute_db("SELECT COUNT(*) FROM accounts")[0][0]
    active = execute_db("SELECT COUNT(*) FROM accounts WHERE is_active=1")[0][0]
    rides = execute_db("SELECT COUNT(*) FROM rides")[0][0]
    total_balance = execute_db("SELECT SUM(balance) FROM accounts")[0][0] or 0
    await message.answer(
        f"{ACCOUNTS_HTML} Статистика:\nВсего: {total}\nАктивных: {active}\nПоездок: {rides}\nСуммарный баланс: {total_balance}",
        reply_markup=main_kb, parse_mode='HTML'
    )

# =========================== ЗАПУСК ===========================
async def main():
    logging.basicConfig(level=logging.INFO)
    init_db()
    scheduler.add_job(check_all_accounts, 'interval', hours=CHECK_INTERVAL_HOURS)
    scheduler.start()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
