# =========================== БАЗА ДАННЫХ ===========================
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            phone TEXT UNIQUE,
            password TEXT,
            token TEXT,
            balance INTEGER DEFAULT 0,
            is_active INTEGER DEFAULT 1,
            last_check TEXT,
            created_at TEXT
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS rides (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            account_id INTEGER,
            ride_id TEXT,
            start_time TEXT,
            end_time TEXT,
            distance REAL,
            cost REAL,
            status TEXT,
            FOREIGN KEY(account_id) REFERENCES accounts(id)
        )
    ''')
    conn.commit()
    conn.close()

def execute_db(query, params=()):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(query, params)
    if query.strip().upper().startswith("SELECT"):
        result = c.fetchall()
        conn.close()
        return result
    else:
        conn.commit()
        last_id = c.lastrowid
        conn.close()
        return last_id

# =========================== SMS-ПРОВАЙДЕРЫ ===========================
class SMSActivateProvider:
    def __init__(self, api_key):
        self.api_key = api_key

    async def _request(self, action, **params):
        params['api_key'] = self.api_key
        params['action'] = action
        url = f"{SMS_ACTIVATE_URL}?{urlencode(params)}"
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=10) as resp:
                return await resp.text()

    async def get_number(self):
        resp = await self._request("getNumber", service=SMS_SERVICE, country=0)
        if resp.startswith("ACCESS_NUMBER"):
            _, act_id, phone = resp.split(":")
            return act_id, phone
        elif "NO_BALANCE" in resp:
            raise Exception("NO_BALANCE")
        else:
            raise Exception(f"SMS-Activate ошибка: {resp}")

    async def get_code(self, activation_id, timeout=180):
        start = time.time()
        while time.time() - start < timeout:
            resp = await self._request("getStatus", id=activation_id)
            if resp.startswith("STATUS_OK"):
                return resp.split(":")[1]
            elif resp == "STATUS_WAIT_CODE":
                await asyncio.sleep(10)
            else:
                break
        raise Exception("Код не получен")

    async def set_status(self, activation_id, status=1):
        await self._request("setStatus", id=activation_id, status=status)


class FiveSimProvider:
    def __init__(self, api_key):
        self.api_key = api_key

    async def get_number(self):
        if not self.api_key:
            raise Exception("NO_API_KEY")
        headers = {"Authorization": f"Bearer {self.api_key}"}
        url = "https://5sim.net/v1/user/buy/activation/ru/any/whoosh"
        async with aiohttp.ClientSession() as session:
            async with session.get(url, headers=headers, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    return data['id'], data['phone']
                elif resp.status == 402:
                    raise Exception("NO_BALANCE")
                else:
                    raise Exception(f"5sim ошибка: {await resp.text()}")

    async def get_code(self, activation_id, timeout=180):
        raise Exception("5sim не поддерживает автоматическое получение кода")

    async def set_status(self, activation_id, status=1):
        pass


class FreeSMSProvider:
    def __init__(self):
        self.sources = FREE_SOURCES

    async def _fetch(self, url):
        headers = {"User-Agent": get_random_user_agent()}
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(url, headers=headers, timeout=15) as resp:
                    if resp.status == 200:
                        return await resp.text()
        except Exception as e:
            logging.error(f"Ошибка загрузки {url}: {e}")
        return None

    async def get_number(self):
        for url in self.sources:
            try:
                html = await self._fetch(url)
                if not html:
                    continue
                phones = extract_phones(html)
                for phone in phones:
                    # Ищем ссылку на страницу номера
                    pattern = rf'<a[^>]*href="([^"]*)"[^>]*>[^<]*{phone}[^<]*</a>'
                    match = re.search(pattern, html, re.IGNORECASE)
                    if match:
                        href = match.group(1)
                        if not href.startswith('http'):
                            href = url.rstrip('/') + '/' + href.lstrip('/')
                        phone_html = await self._fetch(href)
                        if phone_html and "whoosh" in phone_html.lower():
                            return phone, phone
                    else:
                        # Если ссылки нет, но на главной странице есть упоминание whoosh
                        if "whoosh" in html.lower():
                            return phone, phone
            except Exception as e:
                logging.error(f"Ошибка в {url}: {e}")
                continue
        raise Exception("Не удалось найти бесплатный номер для Whoosh ни в одном из 30 сервисов")

    async def get_code(self, activation_id, timeout=180):
        phone = activation_id
        start = time.time()
        for url in self.sources:
            possible_urls = [
                f"{url}phone/{phone}",
                f"{url}{phone}",
                f"{url}?number={phone}",
                f"{url}inbox/{phone}",
                f"{url}number/{phone}"
            ]
            for page_url in possible_urls:
                while time.time() - start < timeout:
                    html = await self._fetch(page_url)
                    if html:
                        codes = extract_codes(html)
                        if codes:
                            return codes[0]
                    await asyncio.sleep(10)
        raise Exception("Код не найден в бесплатных сервисах")

    async def set_status(self, activation_id, status=1):
        pass


class SmartSMSProvider:
    def __init__(self):
        self.providers = []
        if SMS_ACTIVATE_KEY:
            self.providers.append(SMSActivateProvider(SMS_ACTIVATE_KEY))
        if FIVESIM_API_KEY:
            self.providers.append(FiveSimProvider(FIVESIM_API_KEY))
        self.providers.append(FreeSMSProvider())
        self.current_idx = 0

    async def get_number(self):
        errors = []
        for i, provider in enumerate(self.providers):
            try:
                act_id, phone = await provider.get_number()
                self.current_idx = i
                return act_id, phone
            except Exception as e:
                errors.append(f"{provider.__class__.__name__}: {e}")
        raise Exception(f"Все провайдеры не работают: {errors}")

    async def get_code(self, activation_id, timeout=180):
        return await self.providers[self.current_idx].get_code(activation_id, timeout)

    async def set_status(self, activation_id, status=1):
        await self.providers[self.current_idx].set_status(activation_id, status)

# =========================== ГЕНЕРАТОР АККАУНТОВ ===========================
class AccountGenerator:
    def __init__(self):
        self.sms = SmartSMSProvider()

    async def _whoosh_request(self, method, endpoint, data=None, token=None):
        headers = {
            "User-Agent": get_random_user_agent(),
            "Content-Type": "application/json"
        }
        if token:
            headers["Authorization"] = f"Bearer {token}"
        url = WHOOSH_API_BASE + endpoint
        async with aiohttp.ClientSession() as session:
            async with session.request(method, url, json=data, headers=headers) as resp:
                if resp.status in (200, 201):
                    return await resp.json()
                else:
                    error_text = await resp.text()
                    raise Exception(f"Whoosh API ошибка {resp.status}: {error_text}")

    async def create_account(self):
        act_id, phone = await self.sms.get_number()
        try:
            # 1. Регистрация (отправка SMS)
            reg_data = {"phone": phone, "referral_code": "WB2026"}
            # reg_resp = await self._whoosh_request("POST", "/auth/register", reg_data)
            await asyncio.sleep(1)  # имитация

            # 2. Получение кода
            code = await self.sms.get_code(act_id)

            # 3. Подтверждение
            confirm_data = {"phone": phone, "code": code}
            # confirm_resp = await self._whoosh_request("POST", "/auth/confirm", confirm_data)
            token = f"fake_token_{phone}"  # замените на реальный
            password = "Qwerty123!"

            # 4. Бонус 350 + кэшбэк
            balance = 350 + random.randint(30, 70)

            # 5. Тестовая поездка (закомментирована)
            # ride_start = await self._whoosh_request("POST", "/ride/start", {"lat": 55.75, "lng": 37.61}, token)
            # ride_id = ride_start.get('ride_id')
            # await asyncio.sleep(5)
            # await self._whoosh_request("POST", f"/ride/{ride_id}/stop", {}, token)

            await self.sms.set_status(act_id, 1)

            return {
                "phone": phone,
                "password": password,
                "token": token,
                "balance": balance
            }
        except Exception as e:
            await self.sms.set_status(act_id, 6)
            raise e

# =========================== УПРАВЛЕНИЕ САМОКАТОМ ===========================
class ScooterController:
    def __init__(self, token):
        self.token = token

    async def _request(self, method, endpoint, data=None):
        headers = {
            "Authorization": f"Bearer {self.token}",
            "User-Agent": get_random_user_agent(),
            "Content-Type": "application/json"
        }
        url = WHOOSH_API_BASE + endpoint
        async with aiohttp.ClientSession() as session:
            async with session.request(method, url, json=data, headers=headers) as resp:
                if resp.status == 200:
                    return await resp.json()
                else:
                    error_text = await resp.text()
                    raise Exception(f"Ошибка API: {resp.status} - {error_text}")

    async def start_ride(self):
        return await self._request("POST", "/ride/start", {"lat": 55.75, "lng": 37.61})

    async def stop_ride(self, ride_id):
        return await self._request("POST", f"/ride/{ride_id}/stop", {})

    async def get_info(self, ride_id):
        return await self._request("GET", f"/ride/{ride_id}/info")

# =========================== ПРОВЕРКА АККАУНТОВ ===========================
async def check_all_accounts():
    rows = execute_db("SELECT id, token FROM accounts WHERE is_active=1")
    for acc_id, token in rows:
        try:
            controller = ScooterController(token)
            balance_data = await controller._request("GET", "/user/balance")
            new_balance = balance_data.get("balance", 0)
            is_active = 1
        except:
            new_balance = 0
            is_active = 0
        execute_db(
            "UPDATE accounts SET balance=?, is_active=?, last_check=? WHERE id=?",
            (new_balance, is_active, datetime.now().isoformat(), acc_id)
        )

# =========================== ТЕЛЕГРАМ-БОТ ===========================
bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()
scheduler = AsyncIOScheduler()

# --- Клавиатуры ---
main_kb = ReplyKeyboardMarkup(
    keyboard=[
        [KeyboardButton(text="Генерация")],
        [KeyboardButton(text="Мои аккаунты")],
        [KeyboardButton(text="Статистика")]
    ],
    resize_keyboard=True
)

gen_kb = InlineKeyboardMarkup(inline_keyboard=[
    [InlineKeyboardButton(text="1", callback_data="gen_1"), InlineKeyboardButton(text="5", callback_data="gen_5")],
    [InlineKeyboardButton(text="10", callback_data="gen_10"), InlineKeyboardButton(text="50", callback_data="gen_50")],
    [InlineKeyboardButton(text="100", callback_data="gen_100")],
    [InlineKeyboardButton(text="Назад", callback_data="back_main")]
])

async def send_sticker(chat_id, sticker_id):
    try:
        await bot.send_sticker(chat_id, sticker_id)
    except Exception as e:
        logging.warning(f"Стикер не отправлен: {e}")

@dp.message(Command("start"))
async def cmd_start(message: types.Message):
    await message.answer("Добро пожаловать в бота для управления аккаунтами Whoosh!", reply_markup=main_kb)
    await send_sticker(message.chat.id, STICKER_WELCOME)

@dp.message(F.text == "Генерация")
async def show_gen(message: types.Message):
    await message.answer("Выберите количество аккаунтов:", reply_markup=gen_kb)

@dp.callback_query(F.data.startswith("gen_"))
async def generate(callback: types.CallbackQuery):
    count = int(callback.data.split("_")[1])
    await callback.answer(f"Начинаю создание {count} аккаунтов...")
    asyncio.create_task(gen_task(callback.message, count))
    await callback.message.edit_text(f"⏳ Генерация {count} аккаунтов запущена...")

async def gen_task(message: types.Message, count: int):
    generator = AccountGenerator()
    created = 0
    errors = 0
    result_text = ""
    for i in range(count):
        try:
            acc = await generator.create_account()
            execute_db(
                "INSERT INTO accounts (phone, password, token, balance, is_active, created_at) VALUES (?, ?, ?, ?, ?, ?)",
                (acc['phone'], acc['password'], acc['token'], acc['balance'], 1, datetime.now().isoformat())
            )
            created += 1
            result_text += f"✅ {acc['phone']} – {acc['balance']} баллов\n"
        except Exception as e:
            errors += 1
            result_text += f"❌ Ошибка: {e}\n"
        await asyncio.sleep(0.5)
    final_text = f"Генерация завершена.\nУспешно: {created}\nОшибок: {errors}\n\n{result_text[:4000]}"
    await message.edit_text(final_text, reply_markup=gen_kb)
    if created > 0:
        await send_sticker(message.chat.id, STICKER_SUCCESS)
    else:
        await send_sticker(message.chat.id, STICKER_ERROR)

@dp.message(F.text == "Мои аккаунты")
async def list_accounts(message: types.Message):
    rows = execute_db("SELECT id, phone, balance, is_active FROM accounts ORDER BY created_at DESC LIMIT 50")
    if not rows:
        await message.answer("Нет аккаунтов.", reply_markup=main_kb)
        return
    kb = InlineKeyboardMarkup(inline_keyboard=[])
    for row in rows:
        status = "🟢 активен" if row[3] else "🔴 неактивен"
        kb.inline_keyboard.append([
            InlineKeyboardButton(text=f"{row[1]} – {row[2]} баллов ({status})", callback_data=f"acc_{row[0]}")
        ])
    kb.inline_keyboard.append([InlineKeyboardButton(text="🔙 Назад", callback_data="back_main")])
    await message.answer(f"{FOLDER_HTML} Ваши аккаунты:", reply_markup=kb, parse_mode='HTML')

@dp.callback_query(F.data.startswith("acc_"))
async def account_detail(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    row = execute_db("SELECT phone, balance, is_active FROM accounts WHERE id=?", (acc_id,))
    if not row:
        await callback.answer("Не найден.")
        return
    acc = row[0]
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🛵 Запустить самокат", callback_data=f"ride_start_{acc_id}")],
        [InlineKeyboardButton(text="🔄 Обновить баланс", callback_data=f"refresh_{acc_id}")],
        [InlineKeyboardButton(text=f"{EMOJI_DELETE} Удалить", callback_data=f"del_{acc_id}")],
        [InlineKeyboardButton(text="🔙 Назад", callback_data="back_accounts")]
    ])
    text = f"{PHONE_HTML} Аккаунт: {acc[0]}\n💰 Баланс: {acc[1]}\n📊 Статус: {'активен' if acc[2] else 'неактивен'}"
    await callback.message.edit_text(text, reply_markup=kb, parse_mode='HTML')

@dp.callback_query(F.data.startswith("ride_start_"))
async def start_ride(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[2])
    row = execute_db("SELECT token FROM accounts WHERE id=?", (acc_id,))
    if not row:
        await callback.answer("Аккаунт не найден.")
        await send_sticker(callback.message.chat.id, STICKER_ERROR)
        return
    token = row[0][0]
    controller = ScooterController(token)
    try:
        ride_data = await controller.start_ride()
        ride_id = ride_data.get('ride_id')
        execute_db(
            "INSERT INTO rides (account_id, ride_id, start_time, status) VALUES (?, ?, ?, ?)",
            (acc_id, ride_id, datetime.now().isoformat(), "started")
        )
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="⏹️ Завершить", callback_data=f"ride_stop_{acc_id}_{ride_id}")],
            [InlineKeyboardButton(text="📊 Статус", callback_data=f"ride_status_{ride_id}")],
            [InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_{acc_id}")]
        ])
        await callback.message.edit_text(f"Поездка начата! ID: {ride_id}", reply_markup=kb)
        await send_sticker(callback.message.chat.id, STICKER_SUCCESS)
    except Exception as e:
        await callback.answer(f"Ошибка: {e}")
        await send_sticker(callback.message.chat.id, STICKER_ERROR)

@dp.callback_query(F.data.startswith("ride_stop_"))
async def stop_ride(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    acc_id = int(parts[2])
    ride_id = parts[3]
    row = execute_db("SELECT token FROM accounts WHERE id=?", (acc_id,))
    if not row:
        await callback.answer("Аккаунт не найден.")
        await send_sticker(callback.message.chat.id, STICKER_ERROR)
        return
    token = row[0][0]
    controller = ScooterController(token)
    try:
        result = await controller.stop_ride(ride_id)
        execute_db(
            "UPDATE rides SET end_time=?, distance=?, cost=?, status='finished' WHERE ride_id=?",
            (datetime.now().isoformat(), result.get('distance', 0), result.get('cost', 0), ride_id)
        )
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🔙 Назад", callback_data=f"acc_{acc_id}")]
        ])
        await callback.message.edit_text(
            f"Поездка завершена!\nДистанция: {result.get('distance', 0):.2f} км\nСтоимость: {result.get('cost', 0):.2f} руб.",
            reply_markup=kb
        )
        await send_sticker(callback.message.chat.id, STICKER_SUCCESS)
    except Exception as e:
        await callback.answer(f"Ошибка: {e}")
        await send_sticker(callback.message.chat.id, STICKER_ERROR)

@dp.callback_query(F.data.startswith("ride_status_"))
async def ride_status(callback: types.CallbackQuery):
    ride_id = callback.data.split("_")[2]
    row = execute_db(
        "SELECT accounts.token FROM rides JOIN accounts ON rides.account_id=accounts.id WHERE rides.ride_id=?",
        (ride_id,)
    )
    if not row:
        await callback.answer("Поездка не найдена.")
        await send_sticker(callback.message.chat.id, STICKER_ERROR)
        return
    token = row[0][0]
    controller = ScooterController(token)
    try:
        info = await controller.get_info(ride_id)
        await callback.answer(
            f"Статус: {info.get('status', 'неизвестно')}\nДистанция: {info.get('distance', 0):.2f} км\nСтоимость: {info.get('cost', 0):.2f} руб.",
            show_alert=True
        )
    except Exception as e:
        await callback.answer(f"Ошибка: {e}", show_alert=True)
        await send_sticker(callback.message.chat.id, STICKER_ERROR)

@dp.callback_query(F.data.startswith("refresh_"))
async def refresh_balance(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    await check_all_accounts()
    await account_detail(callback)
    await send_sticker(callback.message.chat.id, STICKER_SUCCESS)

@dp.callback_query(F.data.startswith("del_"))
async def delete_account(callback: types.CallbackQuery):
    acc_id = int(callback.data.split("_")[1])
    execute_db("DELETE FROM accounts WHERE id=?", (acc_id,))
    execute_db("DELETE FROM rides WHERE account_id=?", (acc_id,))
    await callback.answer("Удалён.")
    await callback.message.delete()
    await list_accounts(callback.message)
    await send_sticker(callback.message.chat.id, STICKER_SUCCESS)

@dp.callback_query(F.data == "back_main")
async def back_main(callback: types.CallbackQuery):
    await callback.message.delete()
    await callback.message.answer("Главное меню:", reply_markup=main_kb)

@dp.callback_query(F.data == "back_accounts")
async def back_accounts(callback: types.CallbackQuery):
    await list_accounts(callback.message)

@dp.message(F.text == "Статистика")
async def stats(message: types.Message):
    total = execute_db("SELECT COUNT(*) FROM accounts")[0][0]
    active = execute_db("SELECT COUNT(*) FROM accounts WHERE is_active=1")[0][0]
    rides = execute_db("SELECT COUNT(*) FROM rides")[0][0]
    total_balance = execute_db("SELECT SUM(balance) FROM accounts")[0][0] or 0
    await message.answer(
        f"📊 Общая статистика:\nВсего аккаунтов: {total}\nАктивных: {active}\nВсего поездок: {rides}\nСуммарный баланс: {total_balance} баллов",
        reply_markup=main_kb
    )

# =========================== ЗАПУСК ===========================
async def main():
    logging.basicConfig(level=logging.INFO)
    init_db()
    scheduler.add_job(check_all_accounts, 'interval', hours=CHECK_INTERVAL_HOURS)
    scheduler.start()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
