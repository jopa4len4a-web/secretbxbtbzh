LOCAL_API_URL = "http://localhost:8000"  # измени, если сервер на другом порту

# Режим работы: True – реальный API, False – автономный режим (костыль)
USE_REAL_API = True  # если локальный сервер недоступен, бот переключится автоматически

# Код для автономного режима (костыль)
EXPECTED_CODE = "123456"

# Остальные настройки
DB_PATH = "whoosh_bot.db"
CHECK_INTERVAL_HOURS = 12

