# =========================== БАЗА ДАННЫХ ===========================
def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS accounts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            phone TEXT UNIQUE,
            password TEXT,
            token TEXT,
            refresh_token TEXT,
            balance INTEGER DEFAULT 0,
            is_active INTEGER DEFAULT 1,
            last_check TEXT,
            created_at TEXT
        )
    ''')
    c.execute('''
        CREATE TABLE IF NOT EXISTS rides (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            account_id INTEGER,
            ride_id TEXT,
            start_time TEXT,
            end_time TEXT,
            distance REAL,
            cost REAL,
            status TEXT,
            FOREIGN KEY(account_id) REFERENCES accounts(id)
        )
    ''')
    conn.commit()
    conn.close()

def execute_db(query, params=()):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(query, params)
    if query.strip().upper().startswith("SELECT"):
        result = c.fetchall()
        conn.close()
        return result
    else:
        conn.commit()
        last_id = c.lastrowid
        conn.close()
        return last_id

