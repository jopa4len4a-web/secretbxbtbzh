]

def get_random_user_agent():
    return random.choice(USER_AGENTS)

# =========================== ПАРСЕР ДЛЯ БЕСПЛАТНЫХ SMS ===========================
def extract_phones(html):
    pattern = r'(?:\+7|8|7)?\d{10}\b'
    phones = set(re.findall(pattern, html))
    cleaned = []
    for p in phones:
        p = re.sub(r'\D', '', p)
        if len(p) >= 10:
            if len(p) == 11 and p.startswith('7'):
                p = p[1:]
            if len(p) == 11 and p.startswith('8'):
                p = p[1:]
            if len(p) == 10:
                cleaned.append(p)
    return cleaned

def extract_codes(html):
    pattern = r'\b(\d{4,6})\b'
    codes = re.findall(pattern, html)
    return codes

# =========================== SMS-ПРОВАЙДЕРЫ (без изменений) ===========================
class SMSActivateProvider:
    def __init__(self, api_key):
        self.api_key = api_key

    async def _request(self, action, **params):
        params['api_key'] = self.api_key
        params['action'] = action
        url = f"{SMS_ACTIVATE_URL}?{urlencode(params)}"
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=10) as resp:
                return await resp.text()

    async def get_number(self):
        resp = await self._request("getNumber", service=SMS_SERVICE, country=0)
        if resp.startswith("ACCESS_NUMBER"):
            _, act_id, phone = resp.split(":")
            return act_id, phone
        elif "NO_BALANCE" in resp:
            raise Exception("NO_BALANCE")
        else:
            raise Exception(f"SMS-Activate ошибка: {resp}")

    async def get_code(self, activation_id, timeout=180):
        start = time.time()
        while time.time() - start < timeout:
            resp = await self._request("getStatus", id=activation_id)
            if resp.startswith("STATUS_OK"):
                return resp.split(":")[1]
            elif resp == "STATUS_WAIT_CODE":
                await asyncio.sleep(10)
            else:
                break
        raise Exception("Код не получен")

    async def set_status(self, activation_id, status=1):
        await self._request("setStatus", id=activation_id, status=status)

class FiveSimProvider:
    def __init__(self, api_key):
        self.api_key = api_key

    async def get_number(self):
        if not self.api_key:
            raise Exception("NO_API_KEY")
        headers = {"Authorization": f"Bearer {self.api_key}"}
        url = "https://5sim.net/v1/user/buy/activation/ru/any/whoosh"
        async with aiohttp.ClientSession() as session:
            async with session.get(url, headers=headers, timeout=10) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    return data['id'], data['phone']
                elif resp.status == 402:
                    raise Exception("NO_BALANCE")
                else:
                    raise Exception(f"5sim ошибка: {await resp.text()}")

    async def get_code(self, activation_id, timeout=180):
        raise Exception("5sim не поддерживает автоматическое получение кода")

    async def set_status(self, activation_id, status=1):
        pass

class FreeSMSProvider:
    def __init__(self):
        self.sources = FREE_SOURCES

    async def _fetch(self, url):
        headers = {"User-Agent": get_random_user_agent()}
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(url, headers=headers, timeout=15) as resp:
                    if resp.status == 200:
                        return await resp.text()
        except Exception as e:
            logging.error(f"Ошибка загрузки {url}: {e}")
        return None

    async def get_number(self):
        for url in self.sources:
            try:
                html = await self._fetch(url)
                if not html:
                    continue
                phones = extract_phones(html)
                for phone in phones:
                    pattern = rf'<a[^>]*href="([^"]*)"[^>]*>[^<]*{phone}[^<]*</a>'
                    match = re.search(pattern, html, re.IGNORECASE)
                    if match:
                        href = match.group(1)
                        if not href.startswith('http'):
                            href = url.rstrip('/') + '/' + href.lstrip('/')
                        phone_html = await self._fetch(href)
                        if phone_html and "whoosh" in phone_html.lower():
                            return phone, phone
                    else:
                        if "whoosh" in html.lower():
                            return phone, phone
            except Exception as e:
                logging.error(f"Ошибка в {url}: {e}")
                continue
        raise Exception("Не удалось найти бесплатный номер для Whoosh")

    async def get_code(self, activation_id, timeout=180):
        phone = activation_id
        start = time.time()
        for url in self.sources:
            possible_urls = [
                f"{url}phone/{phone}",
                f"{url}{phone}",
                f"{url}?number={phone}",
                f"{url}inbox/{phone}",
                f"{url}number/{phone}"
            ]
            for page_url in possible_urls:
                while time.time() - start < timeout:
                    html = await self._fetch(page_url)
                    if html:
                        codes = extract_codes(html)
                        if codes:
                            return codes[0]
                    await asyncio.sleep(10)
        raise Exception("Код не найден в бесплатных сервисах")

    async def set_status(self, activation_id, status=1):
        pass

class SmartSMSProvider:
    def __init__(self):
        self.providers = []
        if SMS_ACTIVATE_KEY:
            self.providers.append(SMSActivateProvider(SMS_ACTIVATE_KEY))
        if FIVESIM_API_KEY:
            self.providers.append(FiveSimProvider(FIVESIM_API_KEY))
        self.providers.append(FreeSMSProvider())
        self.current_idx = 0

    async def get_number(self):
        errors = []
        for i, provider in enumerate(self.providers):
            try:
                act_id, phone = await provider.get_number()
                self.current_idx = i
                return act_id, phone
            except Exception as e:
                errors.append(f"{provider.__class__.__name__}: {e}")
        raise Exception(f"Все провайдеры не работают: {errors}")

    async def get_code(self, activation_id, timeout=180):
        return await self.providers[self.current_idx].get_code(activation_id, timeout)

    async def set_status(self, activation_id, status=1):
        await self.providers[self.current_idx].set_status(activation_id, status)

# =========================== ОСНОВНАЯ ЛОГИКА (с перебором 5 URL) ===========================
class WhooshAPI:
    def __init__(self, base_urls=None):
        if base_urls is None:
            self.base_urls = POSSIBLE_API_BASES
        else:
            self.base_urls = base_urls
        self.working_url = None  # кеш рабочего URL

    async def _request(self, method, endpoint, data=None, token=None):
        if self.working_url:
            # пробуем сначала рабочий URL
            try:
                return await self._try_request(self.working_url, method, endpoint, data, token)
            except Exception:
                # если старый рабочий URL перестал работать, сбрасываем и ищем заново
                self.working_url = None

        # перебираем все URL
        last_error = None
        for base_url in self.base_urls:
            try:
                result = await self._try_request(base_url, method, endpoint, data, token)
                self.working_url = base_url
                logging.info(f"✅ Найден рабочий API: {base_url}")
                return result
            except Exception as e:
                last_error = e
                logging.warning(f"❌ {base_url} не работает: {e}")
                continue
        raise Exception(f"Все 5 API-адресов недоступны. Последняя ошибка: {last_error}")

    async def _try_request(self, base_url, method, endpoint, data=None, token=None):
        headers = {"User-Agent": get_random_user_agent(), "Content-Type": "application/json"}
        if token:
            headers["Authorization"] = f"Bearer {token}"
        url = base_url + endpoint
        async with aiohttp.ClientSession() as session:
            async with session.request(method, url, json=data, headers=headers, timeout=10) as resp:
                if resp.status in (200, 201):
                    return await resp.json()
                else:
                    error_text = await resp.text()
                    raise Exception(f"API ошибка {resp.status}: {error_text}")

    async def register(self, phone):
        return await self._request("POST", "/auth/register", {"phone": phone, "referral_code": "WB2026"})

    async def confirm(self, phone, code):
        return await self._request("POST", "/auth/confirm", {"phone": phone, "code": code})

    async def get_balance(self, token):
        return await self._request("GET", "/user/balance", token=token)

    async def start_ride(self, token):
        return await self._request("POST", "/ride/start", {"lat": 55.75, "lng": 37.61}, token)

    async def stop_ride(self, token, ride_id):
        return await self._request("POST", f"/ride/{ride_id}/stop", {}, token)

    async def get_ride_info(self, token, ride_id):
        return await self._request("GET", f"/ride/{ride_id}/info", token=token)

# =========================== ГЕНЕРАТОР АККАУНТОВ ===========================
class AccountGenerator:
    def __init__(self):
        self.sms = SmartSMSProvider()
        self.api = WhooshAPI()

    async def create_account_auto(self):
        act_id, phone = await self.sms.get_number()
        try:
            await self.api.register(phone)
            code = await self.sms.get_code(act_id)
            resp = await self.api.confirm(phone, code)
            token = resp.get("token")
            refresh_token = resp.get("refresh_token")
            balance_resp = await self.api.get_balance(token)
            balance = balance_resp.get("balance", 0)
            await self.sms.set_status(act_id, 1)
            return {
                "phone": phone,
                "password": "Qwerty123!",
                "token": token,
                "refresh_token": refresh_token,
                "balance": balance
            }
        except Exception as e:
            await self.sms.set_status(act_id, 6)
            raise e

    async def register_with_manual_code(self, phone: str, code: str):
        try:
            resp = await self.api.confirm(phone, code)
            token = resp.get("token")
            refresh_token = resp.get("refresh_token")
            balance_resp = await self.api.get_balance(token)
            balance = balance_resp.get("balance", 0)
            return {
                "phone": phone,
                "password": "Qwerty123!",
                "token": token,
                "refresh_token": refresh_token,
                "balance": balance
            }
        except Exception as e:
            if "неверный код" in str(e).lower() or "invalid" in str(e).lower():
                raise Exception("Неверный код подтверждения. Попробуйте снова.")
            else:
                raise Exception(f"Ошибка регистрации: {e}")

