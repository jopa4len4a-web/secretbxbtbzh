    return random.choice(USER_AGENTS)

# =========================== РАБОТА С WHOOSH API (локальный сервер) ===========================
class WhooshAPI:
    def __init__(self, base_url=LOCAL_API_URL):
        self.base_url = base_url
        self.session = aiohttp.ClientSession()

    async def close(self):
        await self.session.close()

    async def _request(self, method, endpoint, data=None, token=None):
        headers = {"Content-Type": "application/json"}
        if token:
            headers["Authorization"] = f"Bearer {token}"
        url = f"{self.base_url}{endpoint}"
        try:
            async with self.session.request(method, url, json=data, headers=headers, timeout=10) as resp:
                if resp.status in (200, 201):
                    return await resp.json()
                else:
                    error_text = await resp.text()
                    raise Exception(f"API ошибка {resp.status}: {error_text}")
        except aiohttp.ClientError as e:
            raise Exception(f"Сервер недоступен: {e}")
        except asyncio.TimeoutError:
            raise Exception("Таймаут соединения с сервером")

    async def register(self, phone, code):
        """Регистрация (подтверждение кода)"""
        data = {"phone": phone, "code": code}
        return await self._request("POST", "/auth/confirm", data)

    async def get_balance(self, token):
        """Получение баланса"""
        return await self._request("GET", "/user/balance", token=token)

    async def start_ride(self, token):
        """Начать поездку"""
        return await self._request("POST", "/ride/start", {"lat": 55.75, "lng": 37.61}, token)

    async def stop_ride(self, token, ride_id):
        """Завершить поездку"""
        return await self._request("POST", f"/ride/{ride_id}/stop", {}, token)

    async def get_ride_info(self, token, ride_id):
        """Информация о поездке"""
        return await self._request("GET", f"/ride/{ride_id}/info", token=token)

# =========================== ГЛАВНЫЙ КЛАСС ГЕНЕРАТОРА ===========================
class AccountGenerator:
    def __init__(self):
        self.api = WhooshAPI(LOCAL_API_URL)
        self.use_real_api = USE_REAL_API

    async def _check_api_available(self):
        """Проверяет доступность локального API"""
        try:
            await self.api._request("GET", "/health")
            return True
        except Exception as e:
            logging.warning(f"API недоступен: {e}")
            return False

    async def register_with_manual_code(self, phone: str, code: str):
        """Регистрация с ручным вводом номера и кода"""
        # Проверяем доступность API
        api_available = await self._check_api_available()

        if api_available and self.use_real_api:
            # РЕАЛЬНАЯ РЕГИСТРАЦИЯ
            try:
                resp = await self.api.register(phone, code)
                token = resp.get("token")
                refresh_token = resp.get("refresh_token")
                password = "Qwerty123!"

                # Получаем баланс
                balance_resp = await self.api.get_balance(token)
                balance = balance_resp.get("balance", 0)

                return {
                    "phone": phone,
                    "password": password,
                    "token": token,
                    "refresh_token": refresh_token,
                    "balance": balance
                }
            except Exception as e:
                # Если ошибка "неверный код" – поднимаем её дальше
                if "неверный код" in str(e).lower() or "invalid" in str(e).lower():
                    raise Exception("Неверный код подтверждения. Попробуйте снова.")
                else:
                    # Другая ошибка – пробуем костыль
                    logging.warning(f"Ошибка API, переключаюсь на костыль: {e}")
                    return await self._cooldown_register(phone, code)
        else:
            # КОСТЫЛЬ: проверяем код по ожидаемому значению
            return await self._cooldown_register(phone, code)

    async def _cooldown_register(self, phone: str, code: str):
        """Костыльный режим регистрации (проверка по ожидаемому коду)"""
        if code == EXPECTED_CODE:
            token = f"fake_token_{random.randint(10000,99999)}"
            refresh_token = f"fake_refresh_{random.randint(10000,99999)}"
            password = "Qwerty123!"
            balance = 350 + random.randint(30, 70)
            return {
                "phone": phone,
                "password": password,
                "token": token,
                "refresh_token": refresh_token,
                "balance": balance
            }
        else:
            raise Exception("Неверный код подтверждения. Попробуйте снова.")

    async def create_account_auto(self):
        """Автоматическая генерация (только костыль, т.к. нет SMS-сервиса)"""
        # В автоматическом режиме всегда используем костыль
        phone = f"7{random.randint(1000000000, 9999999999)}"
        token = f"fake_token_{random.randint(10000,99999)}"
        refresh_token = f"fake_refresh_{random.randint(10000,99999)}"
        password = "Qwerty123!"
        balance = 350 + random.randint(30, 70)
        return {
            "phone": phone,
            "password": password,
            "token": token,
            "refresh_token": refresh_token,
            "balance": balance
        }

# =========================== УПРАВЛЕНИЕ САМОКАТОМ ===========================
class ScooterController:
    def __init__(self, token):
        self.token = token
        self.api = WhooshAPI(LOCAL_API_URL)

    async def start_ride(self):
        try:
            return await self.api.start_ride(self.token)
        except Exception as e:
            # Если API недоступен, имитируем
            logging.warning(f"API ошибка при старте поездки: {e}")
            return {"ride_id": f"ride_{random.randint(1000,9999)}"}

    async def stop_ride(self, ride_id):
        try:
            return await self.api.stop_ride(self.token, ride_id)
        except Exception:
            return {"distance": random.uniform(0.5, 5.0), "cost": random.uniform(50, 300)}

    async def get_info(self, ride_id):
        try:
            return await self.api.get_ride_info(self.token, ride_id)
        except Exception:
            return {"status": "finished", "distance": 2.3, "cost": 150}

# =========================== ПРОВЕРКА АККАУНТОВ ===========================
async def check_all_accounts():
    rows = execute_db("SELECT id, token FROM accounts WHERE is_active=1")
    for acc_id, token in rows:
        try:
            api = WhooshAPI(LOCAL_API_URL)
            balance_data = await api.get_balance(token)
            new_balance = balance_data.get("balance", 0)
            is_active = 1
            await api.close()
        except Exception as e:
            logging.warning(f"Не удалось обновить баланс для {acc_id}: {e}")
            # Если токен невалиден, помечаем аккаунт как неактивный
            new_balance = 0
            is_active = 0
        execute_db(
            "UPDATE accounts SET balance=?, is_active=?, last_check=? WHERE id=?",
            (new_balance, is_active, datetime.now().isoformat(), acc_id)
        )

# =========================== FSM ДЛЯ РУЧНОГО ВВОДА ===========================
class AddPhoneStates(StatesGroup):
    waiting_phone = State()
    waiting_code = State()

# =========================== ТЕЛЕГРАМ-БОТ ===========================
bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()
scheduler = AsyncIOScheduler()

